# Copy to .env on the server (never commit .env) and fill in.
# Generate secrets with:  openssl rand -hex 32

# --- Domain (its DNS must point at the server). CRM at https://DOMAIN, engine at https://DOMAIN/engine ---
DOMAIN=crm.smartemploy.io

# --- Database ---
# Self-hosted Postgres in docker compose (default): just set a password.
POSTGRES_PASSWORD=
# Or use Supabase instead: paste its connection string here and set SUPABASE=1.
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
# SUPABASE=1

# --- CRM login ---
# Either a plain password, or (better) a hash made with: cd crm && npm run hash-password -- 'your password'
CRM_PASSWORD=
CRM_PASSWORD_HASH=
SESSION_SECRET=
ENGINE_API_SECRET=

# --- Job sources ---
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Licensed job data incl. major boards, with history (theirstack.com, 1 credit per job)
THEIRSTACK_API_KEY=
# Careerjet partner API (careerjet.co.uk/partners/register/as-publisher); needs the server's public IP
CAREERJET_API_KEY=
CAREERJET_USER_IP=
# Jooble UK key (uk.jooble.org/api/about) - free keys have 500 requests for life
JOOBLE_API_KEY=
# Indeed via Apify (console.apify.com > Integrations > API token). Apify does the scraping; your call.
APIFY_TOKEN=
APIFY_INDEED_ACTOR=valig~indeed-jobs-scraper

# --- Enrichment ---
COMPANIES_HOUSE_API_KEY=
BRAVE_API_KEY=
HUNTER_API_KEY=

# --- Google Sheets (one sheet per lead order, in your own Drive). README > "Google Sheets" ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI assistant on the home page (console.anthropic.com > API keys) ---
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5

# --- Outreach (Smartlead): app.smartlead.ai > Settings > API key. Server-side only. ---
SMARTLEAD_API_KEY=
# where "Test push" sends its one lead
OWNER_TEST_EMAIL=

# --- Tuning (defaults shown) ---
OWNER_EMAIL=
REPOST_THRESHOLD=3
LOOKBACK_DAYS=90
REED_MAX_CALLS_PER_RUN=300
REED_REQUESTS_PER_SECOND=1
ADZUNA_MAX_CALLS_PER_RUN=40
THEIRSTACK_MAX_JOBS_PER_RUN=100
JOOBLE_MAX_REQUESTS_PER_RUN=4
APIFY_INDEED_MAX_ITEMS=300
THEIRSTACK_BACKFILL_DAYS=90
# 1 shows the API docs at https://DOMAIN/engine/docs
ENABLE_DOCS=0
