# DOMAIN may list several hosts, comma separated. One site for everything; Caddy gets and renews the HTTPS certificate itself.
#   https://DOMAIN/          -> CRM
#   https://DOMAIN/engine/*  -> engine API (Make.com uses this; X-API-Key required)
{$DOMAIN} {
	encode gzip
	handle_path /engine/* {
		reverse_proxy engine:8000
	}
	handle {
		reverse_proxy crm:3000
	}
}
