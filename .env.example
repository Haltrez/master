# Copy to .env on the server (never commit .env) and fill in.
# Generate secrets with:  openssl rand -hex 32

# --- Domains (point both DNS A records at your Hetzner server's IP) ---
CRM_DOMAIN=crm.smartemploy.io
ENGINE_DOMAIN=api.smartemploy.io

# --- Database ---
# Self-hosted Postgres in docker compose (default): just set a password.
POSTGRES_PASSWORD=
# Or use Supabase instead: paste its connection string here and set SUPABASE=1.
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
# SUPABASE=1

# --- CRM login ---
# Either a plain password, or (better) a hash made with: cd crm && npm run hash-password -- 'your password'
CRM_PASSWORD=
CRM_PASSWORD_HASH=
SESSION_SECRET=
ENGINE_API_SECRET=

# --- Job sources ---
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Enrichment ---
COMPANIES_HOUSE_API_KEY=
BRAVE_API_KEY=
HUNTER_API_KEY=

# --- Tuning (defaults shown) ---
OWNER_EMAIL=
REPOST_THRESHOLD=3
LOOKBACK_DAYS=90
REED_MAX_CALLS_PER_RUN=300
REED_REQUESTS_PER_SECOND=1
ADZUNA_MAX_CALLS_PER_RUN=40
# 1 shows the API docs at https://ENGINE_DOMAIN/docs
ENABLE_DOCS=0
